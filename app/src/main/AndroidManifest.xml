<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Daftar aplikasi yang bisa dipilih; Android 11+ membatasi query paket. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Progres unduhan model ditampilkan di notifikasi. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Overlay hasil terjemahan mode aksesibilitas. -->
    <!-- Menyinkronkan payload setelah perangkat menyala. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoutTrans">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Provider ini sengaja diekspor tanpa permission: aplikasi target tidak
            mungkin mendeklarasikan permission milik RoutTrans. Isinya hanya
            terjemahan teks yang dikirim pemanggil, jadi tidak ada data pribadi
            yang terbuka.
        -->
        <provider
            android:name=".translate.TranslateProvider"
            android:authorities="id.ifan.routtrans.translate"
            android:exported="true" />

        <!-- Modul LSPosed: hook teks yang digambar Canvas (Compose, kanvas). -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <!--
            Menyinkronkan dex payload dan zip modul segera setelah APK
            diperbarui, tanpa menunggu aplikasi dibuka.
        -->
        <receiver
            android:name=".system.UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
