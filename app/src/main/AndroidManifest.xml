<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Daftar aplikasi yang bisa dipilih; Android 11+ membatasi query paket. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoutTrans">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Provider ini sengaja diekspor tanpa permission: aplikasi target tidak
            mungkin mendeklarasikan permission milik RoutTrans. Isinya hanya
            terjemahan teks yang dikirim pemanggil, jadi tidak ada data pribadi
            yang terbuka.
        -->
        <provider
            android:name=".translate.TranslateProvider"
            android:authorities="id.ifan.routtrans.translate"
            android:exported="true" />

    </application>

</manifest>
